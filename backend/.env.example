DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
SECRET_KEY=replace-with-a-long-random-secret

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://checkmate-sqk9.onrender.com

DEMO_ADMIN_SECRET=replace-with-a-long-random-demo-admin-secret
REQUIRE_DEMO_TOKEN_FOR_REGISTRATION=false

# Render/Linux example: /usr/games/stockfish
# Local Windows default falls back to backend/engine/stockfish.exe
STOCKFISH_PATH=

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional Cloudflare R2 PGN storage/imports
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_NAME=
